# Data cache
.data/
# No trailing slash: .claude/state is a symlink (verify-completion.sh relocates the
# gate ledger outside the worktree), not a plain directory — a trailing-slash pattern
# would not match it and this machine-specific symlink would get committed.
.claude/state
.claude/handoffs/
