# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo

# Cursor: ignore local/machine state, but ship the portable governance pieces
.cursor/*
!.cursor/agents.md
!.cursor/plans/
!.cursor/rules/
!.cursor/hooks/
!.cursor/hooks.json

# OS
.DS_Store
Thumbs.db

