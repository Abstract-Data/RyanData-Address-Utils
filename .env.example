# ryandata-address-utils has no required environment variables and no secrets —
# it's a standalone parsing library with no external service calls. These are optional.

# Suppress the libpostal-not-installed warning (default: warn). Set to "0" to silence it.
# RYANDATA_LIBPOSTAL_WARN=1

# Override where the optional libpostal data files are looked for/downloaded to.
# LIBPOSTAL_DATA_DIR=/path/to/libpostal/data
